{
    "name": "kcl-vscode-extension",
    "publisher": "kcl",
    "displayName": "KCL",
    "description": "Language extension for KCL",
    "version": "0.2.3",
    "engines": {
        "vscode": "^1.63.0"
    },
    "categories": [
        "Other",
        "Programming Languages"
    ],
    "activationEvents": [
        "onLanguage:KCL",
        "onLanguage:MOD",
        "onCommand:kcl.restartLanguageServer",
        "onCommand:kcl.openPreview",
        "onCommand:kcl.openPreviewToSide",
        "onCommand:kcl.previewUnavailable",
        "onCommand:kcl.previewToSideUnavailable"
    ],
    "main": "./out/extension.js",
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "lint": "eslint . --ext .ts,.tsx",
        "watch": "tsc -watch -p ./",
        "test": "node ./out/test/runTest.js",
        "deploy": "vsce publish --yarn"
    },
    "dependencies": {
        "@types/shelljs": "^0.8.11",
        "axios": "^1.6.2",
        "shelljs": "^0.8.5",
        "vscode-languageclient": "^9.0.1"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.1",
        "@types/node": "^17.0.36",
        "@types/vscode": "^1.63.0",
        "@typescript-eslint/eslint-plugin": "^5.27.0",
        "@typescript-eslint/parser": "^5.27.0",
        "@vscode/test-electron": "^2.3.8",
        "@vscode/vsce": "^2.31.1",
        "eslint": "^8.16.0",
        "mocha": "^10.2.0",
        "typescript": "^4.7.2"
    },
    "contributes": {
        "commands": [
            {
                "command": "kcl.restartLanguageServer",
                "title": "KCL: Restart Language Server"
            },
            {
                "command": "kcl.openPreview",
                "title": "KCL: Data Preview"
            },
            {
                "command": "kcl.openPreviewToSide",
                "title": "KCL: Open Preview to the Side",
                "icon": "$(open-preview)"
            },
            {
                "command": "kcl.previewUnavailable",
                "title": "KCL: Data Preview — fix errors first"
            },
            {
                "command": "kcl.previewToSideUnavailable",
                "title": "KCL: Open Preview to the Side — fix errors first",
                "icon": "$(warning)"
            }
        ],
        "keybindings": [
            {
                "command": "kcl.openPreview",
                "key": "shift+ctrl+v",
                "mac": "shift+cmd+v",
                "when": "editorLangId == KCL"
            },
            {
                "command": "kcl.openPreviewToSide",
                "key": "ctrl+k v",
                "mac": "cmd+k v",
                "when": "editorLangId == KCL"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "kcl.openPreviewToSide",
                    "when": "editorLangId == KCL && !kcl.previewHasErrors",
                    "group": "navigation"
                },
                {
                    "command": "kcl.previewToSideUnavailable",
                    "when": "editorLangId == KCL && kcl.previewHasErrors",
                    "group": "navigation"
                }
            ],
            "editor/title/context": [
                {
                    "command": "kcl.openPreview",
                    "when": "resourceLangId == KCL && !kcl.previewHasErrors",
                    "group": "navigation"
                },
                {
                    "command": "kcl.previewUnavailable",
                    "when": "resourceLangId == KCL && kcl.previewHasErrors",
                    "group": "navigation"
                }
            ],
            "commandPalette": [
                {
                    "command": "kcl.openPreview",
                    "when": "editorLangId == KCL && !kcl.previewHasErrors"
                },
                {
                    "command": "kcl.openPreviewToSide",
                    "when": "editorLangId == KCL && !kcl.previewHasErrors"
                },
                {
                    "command": "kcl.previewUnavailable",
                    "when": "editorLangId == KCL && kcl.previewHasErrors"
                },
                {
                    "command": "kcl.previewToSideUnavailable",
                    "when": "editorLangId == KCL && kcl.previewHasErrors"
                }
            ]
        },
        "type": "object",
        "title": "KCL configuration",
        "properties": {
            "languageServerExample.maxNumberOfProblems": {
                "scope": "resource",
                "type": "number",
                "default": 100,
                "description": "Controls the maximum number of problems produced by the server."
            }
        },
        "languages": [
            {
                "id": "KCL",
                "aliases": [
                    "KCL"
                ],
                "extensions": [
                    ".k"
                ],
                "icon": {
                    "light": "./fileicons/images/kcl-logo.svg",
                    "dark": "./fileicons/images/kcl-logo.svg"
                },
                "configuration": "./language-configuration.json"
            },
            {
                "id": "MOD",
                "extensions": [
                    ".mod",
                    ".mod.lock"
                ]
            }
        ],
        "grammars": [
            {
                "language": "KCL",
                "scopeName": "source.kcl",
                "path": "./syntaxes/KCL.tmLanguage.json"
            },
            {
                "language": "MOD",
                "scopeName": "source.toml",
                "path": "./syntaxes/toml.tmLanguage.json"
            }
        ]
    },
    "icon": "kcl-logo.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/kcl-lang/vscode-kcl"
    }
}